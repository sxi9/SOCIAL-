{
  "name": "socialchat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "sharp",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "migrate": "pnpm --filter @socialchat/server migrate",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
