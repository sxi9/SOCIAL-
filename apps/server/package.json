{
  "name": "@socialchat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "migrate": "tsx src/db/migrate.ts",
    "start": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.637.0",
    "@aws-sdk/lib-storage": "3.637.0",
    "@fastify/cookie": "11.0.1",
    "@socialchat/shared": "workspace:*",
    "argon2": "0.41.1",
    "blurhash": "2.0.5",
    "bullmq": "5.12.0",
    "busboy": "1.6.0",
    "cheerio": "1.0.0",
    "drizzle-orm": "0.36.4",
    "execa": "9.3.1",
    "fastify": "5.2.1",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "5.4.1",
    "postgres": "3.4.5",
    "sharp": "0.33.5",
    "undici": "6.19.8",
    "uuid": "10.0.0",
    "web-push": "3.6.7",
    "ws": "8.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "22.7.5",
    "@types/uuid": "10.0.0",
    "@types/web-push": "3.6.3",
    "@types/ws": "8.5.12",
    "drizzle-kit": "0.28.1",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
