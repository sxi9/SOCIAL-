# ============================================================================
# SocialChat — the ONE env file (ARCHITECTURE §3).
# Used by docker compose AND local dev. Copy to .env and adjust.
#
# Defaults below work for local dev (services reachable on localhost).
# Inside the compose network, hostnames are the service names instead:
#   postgres:5432, redis:6379, minio:9000 — compose services override the
#   host portions per-service (see docker-compose.yml).
# ============================================================================

# Public domain Caddy serves (TLS is automatic once DNS points here).
# Local dev: localhost.
DOMAIN=localhost

# Host ports Caddy publishes. Change these only if 80/443 are already in
# use on this machine (e.g. a laptop running Apache): HTTP_PORT=8080 then
# serves the app at http://localhost:8080.
HTTP_PORT=80
HTTPS_PORT=443

# Public base URL for link previews (invite cards in Telegram/WhatsApp).
# Leave empty on a real domain (derived from the request automatically).
# REQUIRED when exposing via a tunnel (cloudflared/ngrok rewrite the Host
# header): set it to the tunnel URL, e.g. https://something.trycloudflare.com
PUBLIC_ORIGIN=

# --- v0.9 auth pack (API.md §1.70–§1.74, ADR-021) ---
# WebAuthn Relying Party ID for passkeys. Empty = derived: the hostname of
# PUBLIC_ORIGIN when set, else DOMAIN. Passkeys BIND to this domain — on a
# quick tunnel every run is a new domain and enrolled passkeys are orphaned,
# so enroll passkeys only on a stable domain (ADR-021).
WEBAUTHN_RP_ID=
# SMTP password override for the admin Authentication settings (§1.74).
# When set it takes precedence over the encrypted stored value and the
# settings page shows "set via environment". No mailer ships yet (ADR-021):
# this + the admin page store config for the future mailer release.
SMTP_PASSWORD=

# --- v0.8b update banner (API.md §1.69, ADR-020) ---
# GIT_COMMIT is BAKED into the server image at build time (./bored update
# passes --build-arg GIT_COMMIT=$(git rev-parse HEAD) via this variable).
# Empty = dev build; the admin banner then says so instead of guessing.
GIT_COMMIT=
# The git remote the worker peeks at every 6 h via the HTTPS smart protocol
# (GET <url>/info/refs?service=git-upload-pack — first-party git, no API, no
# key). Set it to this instance's public repo URL. Empty = the check is
# skipped and the banner reports update_available: null (honestly unknown).
UPDATE_CHECK_REMOTE=

# --- PostgreSQL 17 (truth: users/messages/seq/cursors) ---
POSTGRES_DB=socialchat
POSTGRES_USER=socialchat
POSTGRES_PASSWORD=socialchat

# Full connection string used by api/worker/migrate.
# In compose: postgres://socialchat:socialchat@postgres:5432/socialchat
DATABASE_URL=postgres://socialchat:socialchat@localhost:5432/socialchat

# --- Redis 7 (presence, BullMQ queues, pub/sub "events" channel; AOF on) ---
# In compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

# --- MinIO (private bucket, compose-network only — never exposed publicly) ---
# In compose: http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media

# --- Sessions ---
# Secret for session-cookie signing. 32+ random bytes; generate for prod:
#   openssl rand -base64 32
SESSION_SECRET=dev-only-insecure-session-secret-change-me

# --- Daily puzzle (API.md §1.27) ---
# Salts the daily word selection: PUZZLE_WORDLIST[sha256("<date>:<secret>")].
# The wordlist and algorithm are public, so this secret is what keeps the
# word unpredictable. Leave empty to derive it from SESSION_SECRET; set it
# explicitly (openssl rand -base64 32) to keep the word schedule stable
# across SESSION_SECRET rotations.
PUZZLE_SECRET=

# --- Web push (VAPID) ---
# Generate a keypair once:  npx web-push generate-vapid-keys
# Leave empty to disable push in local dev (server skips push when unset).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# --- Calls / TURN (v0.6 — API.md §1.42, ADR-014) ---
# Shared secret between the api (mints time-limited HMAC credentials) and the
# coturn service (verifies them; static-auth-secret mode). REQUIRED for calls
# to traverse NAT in production:  openssl rand -hex 32
# Leave empty in local dev: the api returns turn:null and calls still connect
# between same-network peers via host candidates (no relay needed).
# The coturn service is behind the "turn" compose profile AND refuses to start
# with an empty secret (an empty static-auth-secret would be a public open
# relay). To enable TURN set BOTH of these together:
#   TURN_SECRET=$(openssl rand -hex 32)
#   COMPOSE_PROFILES=turn
# NOTE: coturn then publishes 3478/udp+tcp and 49160-49200/udp on the HOST —
# the one exception to only-caddy-publishes; open them in your firewall.
TURN_SECRET=
COMPOSE_PROFILES=
