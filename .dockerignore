# Keep the build context lean; Dockerfiles COPY explicit paths from the root.
.git
node_modules
**/node_modules
.pnpm-store
**/.next
**/dist
**/*.tsbuildinfo
**/out
coverage
.turbo
*.log
.data

# Secrets never enter an image
.env
.env.*
!.env.example

# Not needed inside images
docs
docker-compose*.yml
Caddyfile
README.md
LICENSE
.dockerignore
.gitignore
