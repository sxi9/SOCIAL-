#!/usr/bin/env bash
# bored — Bored Chat control panel (operator CLI).
# Run from the repo root:  ./bored <command>
set -euo pipefail
cd "$(dirname "$0")"

TUNNEL_LOG=".bored-tunnel.log"
TUNNEL_PID=".bored-tunnel.pid"

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

env_get() { grep -E "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2- || true; }
env_set() { # env_set KEY VALUE — update or append in .env
  touch .env
  if grep -qE "^$1=" .env; then
    sed -i "s|^$1=.*|$1=$2|" .env
  else
    printf '%s=%s\n' "$1" "$2" >> .env
  fi
}

http_port() { local p; p="$(env_get HTTP_PORT)"; echo "${p:-80}"; }

cmd_status() {
  say "── Bored Chat status ──"
  echo "Version:  $(git log --oneline -1)"
  git fetch origin main -q 2>/dev/null || true
  local behind; behind=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo '?')
  if [ "$behind" = "0" ]; then echo "Updates:  up to date ✓"; else echo "Updates:  $behind commit(s) behind — run: ./bored update"; fi
  echo "Local:    http://localhost:$(http_port)"
  local po; po="$(env_get PUBLIC_ORIGIN)"
  echo "Public:   ${po:-<not set — run: ./bored tunnel>}"
  if [ -f "$TUNNEL_PID" ] && kill -0 "$(cat "$TUNNEL_PID")" 2>/dev/null; then
    echo "Tunnel:   running (pid $(cat "$TUNNEL_PID"))"
  else
    echo "Tunnel:   not running"
  fi
  echo
  docker compose ps --format "table {{.Name}}\t{{.Status}}" 2>/dev/null || echo "(stack not running)"
}

cmd_update() {
  # --if-behind: used by autoupdate — exit quietly when already current.
  if [ "${1:-}" = "--if-behind" ]; then
    git fetch origin main -q || exit 0
    [ "$(git rev-list --count HEAD..origin/main)" = "0" ] && exit 0
    echo "[$(date '+%F %T')] update available: $(git log --oneline HEAD..origin/main | head -3 | tr '\n' '; ')"
  fi
  say "Pulling latest…"
  git stash push -m "bored-update-autostash" >/dev/null 2>&1 || true
  git pull --ff-only || fail "Pull failed — paste this output to Claude."
  say "Rebuilding (this takes a few minutes — do NOT Ctrl+C)…"
  docker compose up -d --build
  docker compose ps --format "table {{.Name}}\t{{.Status}}"
  say "✓ Updated to: $(git log --oneline -1)"
}

cmd_check() {
  git fetch origin main -q || fail "Could not reach GitHub."
  local behind; behind=$(git rev-list --count HEAD..origin/main)
  if [ "$behind" = "0" ]; then say "✓ Up to date: $(git log --oneline -1)"; else
    say "⬆ $behind update(s) available:"
    git log --oneline HEAD..origin/main | head -10
    echo "Run: ./bored update   (or turn on auto-updates: ./bored autoupdate on)"
  fi
}

CRON_TAG="# bored-autoupdate"
cmd_autoupdate() {
  local here; here="$(pwd)"
  case "${1:-status}" in
    on)
      ( crontab -l 2>/dev/null | grep -v "$CRON_TAG" ;
        echo "*/10 * * * * cd $here && ./bored update --if-behind >> $here/.bored-autoupdate.log 2>&1 $CRON_TAG" ) | crontab -
      say "✓ Auto-update ON — checks GitHub every 10 minutes and pulls+rebuilds"
      echo "  automatically when a new version is pushed. Log: .bored-autoupdate.log"
      echo "  Note: the app restarts briefly (~30-60s) during each auto-update." ;;
    off)
      crontab -l 2>/dev/null | grep -v "$CRON_TAG" | crontab - || true
      say "Auto-update OFF." ;;
    status|*)
      if crontab -l 2>/dev/null | grep -q "$CRON_TAG"; then
        say "Auto-update: ON (every 10 min). Recent activity:"
        tail -5 .bored-autoupdate.log 2>/dev/null || echo "  (no updates pulled yet)"
      else
        say "Auto-update: OFF — turn on with: ./bored autoupdate on"
      fi ;;
  esac
}

cmd_up()   { docker compose up -d; cmd_status; }
cmd_down() { docker compose down; say "Stack stopped (data kept)."; }
cmd_logs() { docker compose logs -f --tail 100 "${1:-api}"; }

cmd_tunnel() {
  command -v cloudflared >/dev/null || fail "cloudflared is not installed.
Install: curl -L https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb -o /tmp/cf.deb && sudo dpkg -i /tmp/cf.deb"
  # stop a previous quick tunnel we started
  if [ -f "$TUNNEL_PID" ] && kill -0 "$(cat "$TUNNEL_PID")" 2>/dev/null; then
    kill "$(cat "$TUNNEL_PID")" 2>/dev/null || true; sleep 1
  fi
  : > "$TUNNEL_LOG"
  say "Starting Cloudflare quick tunnel…"
  nohup cloudflared tunnel --url "http://localhost:$(http_port)" >"$TUNNEL_LOG" 2>&1 &
  echo $! > "$TUNNEL_PID"
  local url=""
  for _ in $(seq 1 30); do
    url=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" | head -1 || true)
    [ -n "$url" ] && break
    sleep 1
  done
  [ -n "$url" ] || fail "Tunnel did not report a URL in 30s — see $TUNNEL_LOG"
  env_set PUBLIC_ORIGIN "$url"
  say "Restarting web with PUBLIC_ORIGIN=$url …"
  docker compose up -d web >/dev/null
  say "✓ Your app is public at:  $url"
  echo "  (Quick-tunnel URLs change on every restart — rerun ./bored tunnel to refresh."
  echo "   For a permanent URL use a real domain, or a named Cloudflare tunnel.)"
}

cmd_tunnel_stop() {
  if [ -f "$TUNNEL_PID" ] && kill -0 "$(cat "$TUNNEL_PID")" 2>/dev/null; then
    kill "$(cat "$TUNNEL_PID")"; rm -f "$TUNNEL_PID"; say "Tunnel stopped."
  else
    say "No tunnel running."
  fi
}

cmd_admin()  { [ -n "${1:-}" ] || fail "Usage: ./bored admin <username>"; docker compose exec api node dist/cli.js grant-admin "$1"; }

# ---------------------------------------------------------------------------
# Full-service migration: everything needed to stand the SAME service up on
# another machine — database (users/chats/everything), media objects, and
# .env (secrets: SESSION_SECRET keeps logins/invites valid, VAPID keys keep
# push subscriptions alive). Redis is deliberately skipped (queues/presence
# are transient) and TLS certs are skipped (the new box mints its own).
# ---------------------------------------------------------------------------
PROJECT="$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]')"
vol() { docker volume inspect "socialchat_$1" >/dev/null 2>&1 && echo "socialchat_$1" || echo "${PROJECT}_$1"; }

cmd_export() {
  [ -f .env ] || fail "No .env here — run from the live install."
  local stamp out tmp
  stamp="$(date +%Y%m%d-%H%M%S)"; out="boredchat-migration-$stamp.tar.gz"; tmp=".bored-export-$stamp"
  mkdir -p "$tmp"
  say "Quiescing writers (api/worker paused — users see a blip)…"
  docker compose stop api worker >/dev/null
  say "Dumping database…"
  docker compose exec -T postgres pg_dump -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" --no-owner | gzip > "$tmp/db.sql.gz"
  say "Archiving media volume…"
  docker run --rm -v "$(vol minio_data):/data:ro" -v "$(pwd)/$tmp:/out" alpine tar -C /data -czf /out/media.tar.gz .
  cp .env "$tmp/env"
  { echo "created=$stamp"; echo "commit=$(git rev-parse HEAD)"; } > "$tmp/MANIFEST"
  tar -czf "$out" -C "$tmp" .
  rm -rf "$tmp"
  docker compose up -d api worker >/dev/null
  say "✓ Migration archive: $out  ($(du -h "$out" | cut -f1))"
  echo "  Contains your SECRETS — move it safely (scp), then delete it."
  echo "  On the new server:  git clone <repo> && cd <repo> && ./bored import $out"
}

cmd_import() {
  local archive="${1:-}"; [ -f "$archive" ] || fail "Usage: ./bored import <boredchat-migration-*.tar.gz>"
  # refuse to clobber an existing install unless forced
  if docker volume inspect "$(vol postgres_data)" >/dev/null 2>&1 && [ "${2:-}" != "--force" ]; then
    fail "A database volume already exists here. This command is for a FRESH server.
To overwrite it anyway (DESTROYS this machine's data): ./bored import $archive --force"
  fi
  local tmp=".bored-import-$$"; mkdir -p "$tmp"; tar -xzf "$archive" -C "$tmp"
  [ -f "$tmp/db.sql.gz" ] && [ -f "$tmp/env" ] || { rm -rf "$tmp"; fail "Archive is missing db.sql.gz or env — not a bored export."; }
  [ -f .env ] && cp .env ".env.pre-import-backup.$$"
  cp "$tmp/env" .env
  say "Imported .env (old one saved as .env.pre-import-backup.$$)."
  echo "  >>> Edit .env NOW if the address changes on this server (DOMAIN, PUBLIC_ORIGIN, ports). <<<"
  say "Resetting data volumes…"
  docker compose down >/dev/null 2>&1 || true
  docker volume rm -f "$(vol postgres_data)" "$(vol minio_data)" >/dev/null 2>&1 || true
  say "Starting database + storage…"
  docker compose up -d postgres minio
  until docker compose exec -T postgres pg_isready -U "$(env_get POSTGRES_USER)" >/dev/null 2>&1; do sleep 2; done
  say "Restoring database…"
  gunzip -c "$tmp/db.sql.gz" | docker compose exec -T postgres psql -q -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)"
  say "Restoring media…"
  docker run --rm -v "$(vol minio_data):/data" -v "$(pwd)/$tmp:/in:ro" alpine tar -C /data -xzf /in/media.tar.gz
  rm -rf "$tmp"
  say "Building and starting the full stack…"
  docker compose up -d --build
  docker compose ps --format "table {{.Name}}\t{{.Status}}"
  say "✓ Migration complete — same users, chats, media, logins and push subscriptions."
}
cmd_backup() {
  mkdir -p backups
  local f="backups/boredchat-$(date +%Y%m%d-%H%M%S).sql.gz"
  docker compose exec -T postgres pg_dump -U "$(env_get POSTGRES_USER)" "$(env_get POSTGRES_DB)" | gzip > "$f"
  say "✓ Database backup: $f  (media lives in the minio_data docker volume)"
}

case "${1:-help}" in
  status)      cmd_status ;;
  update)      cmd_update "${2:-}" ;;
  check)       cmd_check ;;
  autoupdate)  cmd_autoupdate "${2:-}" ;;
  up)          cmd_up ;;
  down)        cmd_down ;;
  logs)        cmd_logs "${2:-}" ;;
  tunnel)      cmd_tunnel ;;
  tunnel-stop) cmd_tunnel_stop ;;
  admin)       cmd_admin "${2:-}" ;;
  backup)      cmd_backup ;;
  export)      cmd_export ;;
  import)      cmd_import "${2:-}" "${3:-}" ;;
  *) cat <<'HELP'
bored — Bored Chat control panel

  ./bored status       what version, what's running, your public link
  ./bored update       git pull + rebuild + restart (safe: data kept)
  ./bored check        is a new version available? shows what changed
  ./bored autoupdate on|off|status
                       self-updating system: checks GitHub every 10 min and
                       pulls+rebuilds automatically when updates are pushed
  ./bored up / down    start / stop the stack
  ./bored tunnel       go public: starts cloudflared, auto-writes the new
                       URL into .env (PUBLIC_ORIGIN) and restarts web —
                       invite-link previews work immediately
  ./bored tunnel-stop  stop the tunnel
  ./bored logs [svc]   follow logs (api, worker, web, caddy, …)
  ./bored admin USER   grant admin to a user
  ./bored backup       gzip database dump into ./backups/
  ./bored export       pack the WHOLE service (users, chats, media, secrets)
                       into one migration archive for moving to a new server
  ./bored import FILE  restore that archive on a fresh server (same users,
                       logins, media and push subscriptions survive)
HELP
  ;;
esac
